@model System.Collections.Generic.List<MvcSmartCctv.Models.Camera>
@if (!(bool)ViewBag.IsAdmin)
{
  <div class="restricted">
    <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></div>
    <h2>Akses Terbatas</h2>
    <p>Halaman Pengaturan hanya bisa diakses oleh role <strong>Admin</strong>. Hubungi Admin Platform kalau kamu butuh perubahan daftar kamera.</p>
  </div>
}
else
{
  <div class="page-head"><h2>Pengaturan</h2></div>

  <section class="panel">
    <div class="panel-head">
      <h2>Kelola Kamera</h2>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Nama</th><th>IP</th><th>Lokasi</th><th>Kategori</th><th>Stream</th><th></th></tr></thead>
        <tbody>
        @if (!Model.Any())
        {
          <tr><td colspan="6" style="text-align:center;color:var(--text-muted);">Belum ada kamera</td></tr>
        }
        else
        {
        foreach (var c in Model)
        {
          <tr class="row-click" style="cursor:pointer;" onclick="document.getElementById('cam-modal-@c.Id').style.display='flex';">
            <td>@c.Name</td>
            <td class="mono">@c.IpAddress</td>
            <td>@(c.Location ?? "-")</td>
            <td>@(c.Category == "vehicle" ? "Vehicle Violation" : "APD Detection")</td>
            <td><span class="badge @(string.IsNullOrEmpty(c.StreamPath) ? "muted" : "success")">@(string.IsNullOrEmpty(c.StreamPath) ? "Belum ada" : "Live")</span></td>
            <td onclick="event.stopPropagation()"><button class="link-btn" onclick="document.getElementById('cam-modal-@c.Id').style.display='flex';">Edit</button></td>
          </tr>
        }
        }
        </tbody>
      </table>
    </div>
  </section>

  foreach (var c in Model)
  {
    <div class="modal-overlay" id="cam-modal-@c.Id" style="display:none;" onclick="if(event.target.id==='cam-modal-@c.Id')this.style.display='none';">
      <div class="modal">
        <div class="modal-head">
          <h3>Edit — @c.Name</h3>
          <button class="modal-close" onclick="document.getElementById('cam-modal-@c.Id').style.display='none';">&times;</button>
        </div>
        <form onsubmit="return false;">
          <div class="modal-body">
            <div class="field"><label>Nama Kamera</label><input type="text" value="@c.Name" disabled /></div>
            <div class="field"><label>Lokasi</label><input type="text" value="@c.Location" disabled /></div>
            <div class="field">
              <label>Kategori Deteksi</label>
              <select disabled>
                <option @(c.Category == "apd" ? "selected" : "")>APD Detection</option>
                <option @(c.Category == "vehicle" ? "selected" : "")>Vehicle Violation</option>
              </select>
            </div>
            <div class="field">
              <label>RTSP URL (opsional)</label>
              <input type="text" value="" disabled placeholder="rtsp://user:pass&#64;192.168.56.110:554/stream1" />
              <div class="hint">Mockup — manajemen kamera tidak tersambung ke backend nyata pada tampilan ini.</div>
            </div>
          </div>
          <div class="modal-actions" style="justify-content:space-between;">
            <button type="button" class="link-btn" style="color:var(--critical);" disabled title="Mockup — tidak ada backend nyata">Hapus Kamera</button>
            <div style="display:flex;gap:0.6rem;">
              <button type="button" class="btn-secondary" onclick="document.getElementById('cam-modal-@c.Id').style.display='none';">Batal</button>
              <button type="submit" class="btn-primary" disabled title="Mockup — tidak ada backend nyata">Simpan Perubahan</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  }
}
